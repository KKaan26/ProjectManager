@model IEnumerable<Project>

<h2>Projeler</h2>
<a asp-action="Create" class="btn btn-primary">Yeni Proje</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Başlangıç</th>
            <th>Tahmini Bitiş</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EstimatedEndDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>
