@model Project
@using System.Collections.Generic

@{
    ViewData["Title"] = "Kanban Tablosu";

    var statusMap = new Dictionary<string, string>
    {
        { "ToDo", "Yapılacak" },
        { "InProgress", "Devam Ediyor" },
        { "Done", "Tamamlandı" },
        { "Abandoned", "Vazgeçildi" }
    };
}

<h2>@Model.Name - Kanban Tablosu</h2>

<div class="container-fluid">
    <div class="d-flex flex-row flex-nowrap overflow-auto gap-3" id="kanban-board">
        @foreach (var status in statusMap)
        {
            <div class="kanban-column bg-light p-3 rounded" data-status="@status.Key" style="min-width: 250px;">
                <h5 class="text-center fw-bold">@status.Value</h5>

                @foreach (var task in Model.Tasks.Where(t => t.Status == status.Key))
                {
                    <div class="task-card border p-2 mb-2 bg-white" draggable="true" data-id="@task.Id">
                        <strong>@task.Description</strong><br />
                        Başlangıç: @task.StartDate.ToShortDateString()<br />
                        Bitiş: @task.EstimatedEndDate.ToShortDateString()
                    </div>
                }

                <div class="d-grid">
                    <button type="button"
                            class="btn btn-sm btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#taskModal"
                            data-status="@status.Key">
                        + Ekle
                    </button>
                </div>
            </div>
        }
    </div>
</div>



<style>
    .kanban-column {
        min-height: 200px;
    }

    .task-card {
        cursor: grab;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let dragged;

        document.querySelectorAll(".task-card").forEach(card => {
            card.addEventListener("dragstart", () => {
                dragged = card;
            });
        });

        document.querySelectorAll(".kanban-column").forEach(col => {
            col.addEventListener("dragover", (e) => e.preventDefault());

            col.addEventListener("drop", (e) => {
                e.preventDefault();
                col.appendChild(dragged);

                const taskId = dragged.dataset.id;
                const newStatus = col.dataset.status;

                fetch('/Tasks/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: taskId, status: newStatus })
                });
            });
        });
    });
</script>

<!-- Modal -->
<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateTask" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="taskModalLabel">Yeni Görev Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ProjectId" value="@Model.Id" />
                    <input type="hidden" name="Status" id="taskStatus" />

                    <div class="mb-3">
                        <label for="desc">Açıklama</label>
                        <input type="text" name="Description" id="desc" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="start">Başlangıç Tarihi</label>
                        <input type="date" name="StartDate" id="start" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="end">Bitiş Tarihi</label>
                        <input type="date" name="EstimatedEndDate" id="end" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const taskModal = document.getElementById('taskModal');
    taskModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const status = button.getAttribute('data-status');
        const statusInput = document.getElementById('taskStatus');
        statusInput.value = status;
    });
</script>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>






